# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log

# Data Lake Zones (Mercari TSV + generated JSONL; GB-scale, never commit)
data/raw/**
!data/raw/mercari/.gitkeep
!data/raw/generated/.gitkeep
data/seed/**
!data/seed/.gitkeep
data/*.7z
data/*.zip
data/*.tsv
data/*.csv
data/processed/*
!data/processed/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/hdfs_sync_manifest.json

# Ground truth (evaluation key for entity resolution; outside the raw zone by design)
data/ground_truth/**
!data/ground_truth/.gitkeep
data/ground_truth_smoke/**

# Next.js Node & Build Directories
node_modules/
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/.vercel/
dashboard/*.tsbuildinfo

# OS / Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

hadoop/
